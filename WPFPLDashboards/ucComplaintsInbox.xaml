<UserControl x:Class="WPFPLDashboards.ucComplaintsInbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="#FFFFFF"
             FontFamily="Segoe UI, Inter, Arial">
    
    <UserControl.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="BrandBlueHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="BrandRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="BrandRedBg" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="BrandBlueBg" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="BrandGreenBg" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="BrandGrayBg" Color="#F1F5F9"/>

        <!-- Message List Item Style -->
        <Style x:Key="MessageListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrandBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Buttons -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8F9FA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryReplyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="64"/>
            <!-- Content Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Area -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title Section -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Inbox Icon -->
                    <Border Width="36" Height="36" Background="#1E293B" CornerRadius="8" Margin="0,0,12,0">
                        <Path Data="M3,4 A1,1 0 0,0 2,5 V17 A3,3 0 0,0 5,20 H19 A3,3 0 0,0 22,17 V5 A1,1 0 0,0 21,4 H3 M4,6 H20 V14 H16 A2,2 0 0,0 14,16 H10 A2,2 0 0,0 8,14 H4 V6 Z" 
                              Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Complaints Inbox" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="txtHeaderUnreadCount" Text="0 unread" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="txtHeaderTotalCount" Text="0 total" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right Filter Section -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Bar -->
                    <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Width="260" Height="36" Margin="0,0,12,0" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Search Icon (magnifier) -->
                            <Path Grid.Column="0" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                                  Fill="#64748B" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                     VerticalContentAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            <!-- Placeholder -->
                            <TextBlock x:Name="lblSearchPlaceholder" Grid.Column="1" Text="Search name or title..." Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13" Margin="2,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Type Filter -->
                    <TextBlock Text="Type:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                    <ComboBox x:Name="comboTypeFilter" Width="140" Height="36" FontSize="13" VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrushColor}">
                        <ComboBoxItem Content="All messages" IsSelected="True"/>
                        <ComboBoxItem Content="Complaint"/>
                        <ComboBoxItem Content="Chat"/>
                        <ComboBoxItem Content="Notification"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Message List (Master) -->
                <ColumnDefinition Width="420"/>
                <!-- Splitter -->
                <ColumnDefinition Width="1"/>
                <!-- Message Detail (Detail) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- A. Left Master Pane -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/> <!-- Table Header -->
                    <RowDefinition Height="*"/>  <!-- List Scroll -->
                    <RowDefinition Height="36"/> <!-- Status Legend -->
                </Grid.RowDefinitions>

                <!-- List Header Column Labels -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PERSON" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Grid.Column="1" Text="TITLE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Grid.Column="2" Text="TYPE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Grid.Column="3" Text="DATE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Master Messages List -->
                <ListBox x:Name="lstMessages" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource MessageListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <!-- Person Name with Read/Unread Dot -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Read/Unread Dot -->
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" x:Name="dotStatus">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource BrandGreen}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource BrandRed}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    
                                    <TextBlock Text="{Binding PersonName}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Title -->
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Type Badge Icon & Label -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Icon Path -->
                                    <Path x:Name="badgeIcon" Margin="0,0,6,0" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MessageType}" Value="Complaint">
                                                        <!-- Alert triangle -->
                                                        <Setter Property="Data" Value="M1,21 H23 L12,2 L1,21 Z M13,18 H11 V16 H13 V18 Z M13,14 H11 V10 H13 V14 Z"/>
                                                        <Setter Property="Fill" Value="{StaticResource TextSecondary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MessageType}" Value="Chat">
                                                        <!-- Chat bubble -->
                                                        <Setter Property="Data" Value="M20,2 H4 C2.9,2 2,2.9 2,4 V22 L6,18 H20 C21.1,18 22,17.1 22,16 V4 C22,2.9 21.1,2 20,2 Z"/>
                                                        <Setter Property="Fill" Value="{StaticResource TextSecondary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MessageType}" Value="Notification">
                                                        <!-- Bell icon -->
                                                        <Setter Property="Data" Value="M12,22 C13.1,22 14,21.1 14,20 H10 C10,21.1 10.9,22 12,22 Z M18,16 V11 C18,7.9 16.4,5.4 13.5,4.7 V4 C13.5,3.2 12.8,2.5 12,2.5 C11.2,2.5 10.5,3.2 10.5,4 V4.7 C7.6,5.4 6,7.9 6,11 V16 L4,18 V19 H20 V18 L18,16 Z"/>
                                                        <Setter Property="Fill" Value="{StaticResource TextSecondary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding MessageType}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Date -->
                                <TextBlock Grid.Column="3" Text="{Binding DisplayDate}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Bottom Status / Count Bar -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="16,0" Background="#F8F9FA">
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="txtShowingCount" Text="Showing 0 of 0" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        
                        <!-- Legend dots -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrandRed}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Unread" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            
                            <Ellipse Width="7" Height="7" Fill="{StaticResource BrandGreen}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Read" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter Border line -->
            <Border Grid.Column="1" Background="{StaticResource BorderBrushColor}" Width="1"/>

            <!-- B. Right Detail Pane -->
            <Grid Grid.Column="2" x:Name="gridDetailPanel" Background="#FFFFFF">
                <!-- If no message selected, we will show a placeholder -->
                <Grid x:Name="gridNoSelectionPlaceholder" Background="#FFFFFF" Panel.ZIndex="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <Border Width="64" Height="64" Background="#F1F5F9" CornerRadius="32" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <!-- Large Mail Icon -->
                            <Path Data="M20,4 H4 C2.9,4 2,4.9 2,6 V18 C2,19.1 2.9,20 4,20 H20 C21.1,20 22,19.1 22,18 V6 C22,4.9 21.1,4 20,4 Z M20,8 L12,13 L4,8 V6 L12,11 L20,6 V8 Z" 
                                  Fill="#94A3B8" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No message selected" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select an email or complaint from the list to view its contents and reply." FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Active Details Grid -->
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <!-- Top Detail Title Section -->
                        <RowDefinition Height="Auto"/>
                        <!-- Contact Info Card -->
                        <RowDefinition Height="Auto"/>
                        <!-- Message Content Area -->
                        <RowDefinition Height="*"/>
                        <!-- Divider -->
                        <RowDefinition Height="Auto"/>
                        <!-- Reply composer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Header section -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Badges line -->
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
                            <!-- Type Badge -->
                            <Border x:Name="borderDetailTypeBadge" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="pathDetailTypeIcon" Fill="{Binding Foreground, ElementName=txtDetailTypeBadge}" Margin="0,0,6,0" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtDetailTypeBadge" Text="COMPLAINT" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Read/Unread badge -->
                            <Border x:Name="borderDetailReadBadge" CornerRadius="4" Padding="8,3">
                                <TextBlock x:Name="txtDetailReadBadge" Text="Read" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Big Title -->
                        <TextBlock Grid.Row="1" x:Name="txtDetailTitle" Text="Weekly performance report available" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>

                        <!-- Received Date -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Received " FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="txtDetailDate" Text="2026-05-16 08:00" FontSize="12" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Contact Info Card -->
                    <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/> <!-- Spacer -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Column 0, Row 0: NAME -->
                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="NAME" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtDetailName" Text="System" FontSize="13.5" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Column 1, Row 0: NATIONAL NO. -->
                            <StackPanel Grid.Column="1" Grid.Row="0">
                                <TextBlock Text="NATIONAL NO." FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtDetailNationalNo" Text="—" FontSize="13.5" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>

                            <!-- Column 0, Row 2: EMAIL -->
                            <StackPanel Grid.Column="0" Grid.Row="2">
                                <TextBlock Text="EMAIL" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtDetailEmail" Text="noreply@system.local" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>

                            <!-- Column 1, Row 2: PHONE / APPLICATION TYPE -->
                            <Grid Grid.Column="1" Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PHONE" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtDetailPhone" Text="—" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="APPLICATION TYPE" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtDetailAppType" Text="—" FontSize="13" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 2: Message Content Area -->
                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="MESSAGE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtDetailContent" Text="Your weekly performance report is now ready..." FontSize="13.5" Foreground="{StaticResource TextPrimary}" LineHeight="20" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- Row 3: Divider line -->
                    <Border Grid.Row="3" Background="{StaticResource BorderBrushColor}" Height="1" Margin="0,0,0,16"/>

                    <!-- Row 4: Reply Composer -->
                    <Grid Grid.Row="4" x:Name="gridReplyComposer">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Reply input text box -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="REPLY" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Height="100" Padding="8">
                                <Grid>
                                    <TextBox x:Name="txtReplyBox" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap"
                                             FontSize="13" Foreground="{StaticResource TextPrimary}" AcceptsTab="True" VerticalScrollBarVisibility="Auto"/>
                                    <!-- Placeholder -->
                                    <TextBlock x:Name="lblReplyPlaceholder" Text="Type your reply to the customer..." Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Top" FontSize="13" Margin="2,2,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Actions bar -->
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <!-- Left mark as read button -->
                            <Button x:Name="btnMarkRead" Content="Mark as Read" HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}">
                                <!-- Let's put a custom check icon in it inside WPF code behind -->
                            </Button>

                            <!-- Right send reply button -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnSendReply" Style="{StaticResource PrimaryReplyButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Paper plane icon path -->
                                        <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Send Reply" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
