<UserControl x:Class="WPFPLDashboards.ucSchoolDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFPLDashboards"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="#13131A">
    
    <UserControl.Resources>
        <!-- Modern Theme Gradients -->
        <LinearGradientBrush x:Key="CyanBlueGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00F2FE" Offset="0"/>
            <GradientStop Color="#4FACFE" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="PurplePinkGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7F00FF" Offset="0"/>
            <GradientStop Color="#E100FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreenTealGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11998e" Offset="0"/>
            <GradientStop Color="#38ef7d" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OrangeGoldGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F12711" Offset="0"/>
            <GradientStop Color="#F5AF19" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBackground" Color="#1C1C24"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8F92A1"/>
        <SolidColorBrush x:Key="GridLineColor" Color="#292936"/>

        <!-- Base Card Style -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#292936"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3E3F52"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- KPI Card Value Style -->
        <Style x:Key="KPIValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- KPI Card Title Style -->
        <Style x:Key="KPITitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Styled DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#1C1C24"/>
            <Setter Property="AlternatingRowBackground" Value="#22222E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#252536"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style x:Key="DataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#171720"/>
            <Setter Property="Foreground" Value="#8F92A1"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Linear Progress Bar -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#292936"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}"/>
                            <Border CornerRadius="4" x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Title Row -->
            <RowDefinition Height="Auto"/>
            <!-- KPI Cards Row -->
            <RowDefinition Height="Auto"/>
            <!-- Charts and Pass Rates Row -->
            <RowDefinition Height="*"/>
            <!-- Tables and Actions Row -->
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Driving School Dashboard" Foreground="{StaticResource TextPrimary}" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI"/>
                <TextBlock Text="Institute Performance &amp; KPI Analytics" Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,4,0,0" FontFamily="Segoe UI"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1D2A4A" BorderBrush="#2E4374" BorderThickness="1" Padding="12,8" Cursor="Hand" Click="btnRefresh_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,8l-4,4h3c0,3.31-2.69,6-6,6c-1.01,0-1.97-0.25-2.8-0.7l-1.46,1.46C8.97,19.54,10.43,20,12,20c4.42,0,8-3.58,8-8h3L19,8z M6,12c0-3.31,2.69-6,6-6c1.01,0,1.97,0.25,2.8,0.7l1.46-1.46C15.03,4.46,13.57,4,12,4c-4.42,0-8,3.58-8,8H1l4,4l4-4H6z" 
                          Fill="#00F2FE" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Refresh Dashboard" Foreground="#00F2FE" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- KPI CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Students -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL STUDENTS" Style="{StaticResource KPITitleText}"/>
                        <TextBlock x:Name="txtTotalStudents" Text="0" Style="{StaticResource KPIValueText}"/>
                        <Border Background="#1A3343" HorizontalAlignment="Left" CornerRadius="4" Margin="0,8,0,0" Padding="6,3">
                            <TextBlock x:Name="txtNewStudents" Text="+0 this month" Foreground="#00F2FE" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#1A3343" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top">
                        <Path Data="M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4s-4,1.79-4,4S9.79,12,12,12z M12,14c-2.67,0-8,1.34-8,4v2h16v-2C20,15.34,14.67,14,12,14z" 
                              Fill="#00F2FE" Width="22" Height="22" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Batches & Waiting List -->
            <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="12,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ACTIVE TRAINING BATCHES" Style="{StaticResource KPITitleText}"/>
                        <TextBlock x:Name="txtActiveBatches" Text="0" Style="{StaticResource KPIValueText}"/>
                        <Border Background="#331A4A" HorizontalAlignment="Left" CornerRadius="4" Margin="0,8,0,0" Padding="6,3">
                            <TextBlock x:Name="txtWaitingList" Text="0 Waiting List" Foreground="#E100FF" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#331A4A" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top">
                        <Path Data="M4,6H2v14c0,1.1,0.9,2,2,2h14v-2H4V6z M20,2H8C6.9,2,6,2.9,6,4v12c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M20,16H8V4h12V16z" 
                              Fill="#E100FF" Width="22" Height="22" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Attendance -->
            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Margin="12,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DAILY ATTENDANCE RATE" Style="{StaticResource KPITitleText}"/>
                        <TextBlock x:Name="txtAttendanceRate" Text="0%" Style="{StaticResource KPIValueText}"/>
                        <Border Background="#133827" HorizontalAlignment="Left" CornerRadius="4" Margin="0,8,0,0" Padding="6,3">
                            <TextBlock Text="Today's attendance" Foreground="#38ef7d" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#133827" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top">
                        <Path Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41z" 
                              Fill="#38ef7d" Width="22" Height="22" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Total Revenue -->
            <Border Grid.Column="3" Style="{StaticResource DashboardCard}" Margin="12,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL EARNINGS" Style="{StaticResource KPITitleText}"/>
                        <TextBlock x:Name="txtTotalEarnings" Text="$0" Style="{StaticResource KPIValueText}"/>
                        <Border Background="#382813" HorizontalAlignment="Left" CornerRadius="4" Margin="0,8,0,0" Padding="6,3">
                            <TextBlock Text="Accumulated revenue" Foreground="#F5AF19" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#382813" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top">
                        <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-2h2V17z M13,13h-2V7h2V13z" 
                              Fill="#F5AF19" Width="22" Height="22" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- CHARTS AND PASS RATES -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Enrollment Trend Chart -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Monthly Student Registrations" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" FontFamily="Segoe UI"/>
                    
                    <Canvas x:Name="ChartCanvas" Grid.Row="1" Background="Transparent" SizeChanged="ChartCanvas_SizeChanged" ClipToBounds="True"/>
                </Grid>
            </Border>

            <!-- Test Pass Rates -->
            <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Test Types Success Rate" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" FontFamily="Segoe UI"/>
                    
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Vision Test -->
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Vision Test Pass Rate" Foreground="{StaticResource TextSecondary}" FontSize="12" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="txtVisionRate" Grid.Row="0" Text="0%" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="Segoe UI"/>
                            <ProgressBar x:Name="progressVision" Grid.Row="1" Value="0" Foreground="{StaticResource CyanBlueGradient}" Style="{StaticResource ModernProgressBar}" Margin="0,8,0,0"/>
                        </Grid>

                        <!-- Theory Test -->
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Theory Test Pass Rate" Foreground="{StaticResource TextSecondary}" FontSize="12" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="txtTheoryRate" Grid.Row="0" Text="0%" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="Segoe UI"/>
                            <ProgressBar x:Name="progressTheory" Grid.Row="1" Value="0" Foreground="{StaticResource PurplePinkGradient}" Style="{StaticResource ModernProgressBar}" Margin="0,8,0,0"/>
                        </Grid>

                        <!-- Road Test -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Road Test Pass Rate" Foreground="{StaticResource TextSecondary}" FontSize="12" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="txtRoadRate" Grid.Row="0" Text="0%" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="Segoe UI"/>
                            <ProgressBar x:Name="progressRoad" Grid.Row="1" Value="0" Foreground="{StaticResource GreenTealGradient}" Style="{StaticResource ModernProgressBar}" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- TABLES & QUICK ACTIONS -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Recent Students Table -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Recent Enrolled Students" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" FontFamily="Segoe UI"/>
                    
                    <DataGrid x:Name="dgvRecentStudents" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student Name" Binding="{Binding FullName}" Width="*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Course" Binding="{Binding ClassName}" Width="1.2*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Enrollment Date" Binding="{Binding EnrollmentDate, StringFormat={}{0:yyyy-MM-dd}}" Width="1.2*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByUserName}" Width="0.8*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Quick Action Buttons -->
            <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Quick Operations Control" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" FontFamily="Segoe UI"/>
                    
                    <UniformGrid Grid.Row="1" Columns="2">
                        <!-- Take Attendance -->
                        <Button Margin="6" Background="#1D202D" BorderBrush="#252536" BorderThickness="1" Cursor="Hand" Click="btnAttendance_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                                      Fill="#00F2FE" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Attendance" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="Check-in students" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Students Directory -->
                        <Button Margin="6" Background="#1D202D" BorderBrush="#252536" BorderThickness="1" Cursor="Hand" Click="btnStudents_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                      Fill="#E100FF" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Students" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="Manage list" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Schedule Test -->
                        <Button Margin="6" Background="#1D202D" BorderBrush="#252536" BorderThickness="1" Cursor="Hand" Click="btnScheduleTest_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm-5-7h-4v4h4v-4z"
                                      Fill="#38ef7d" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Test Schedules" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="Manage tests" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Institute Courses -->
                        <Button Margin="6" Background="#1D202D" BorderBrush="#252536" BorderThickness="1" Cursor="Hand" Click="btnCourses_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5.47 18.6L12 22l6.53-3.4V15.6L12 19l-6.53-3.4v3z"
                                      Fill="#F5AF19" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Courses" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="View training" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
