<UserControl x:Class="WPFPLDashboards.ucSchoolDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFPLDashboards"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F3F5F9"
             FontFamily="Segoe UI">
    
    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MainBackground" Color="#F3F5F9"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="BorderLight" Color="#EAECEF"/>
        
        <!-- Brand Colors -->
        <SolidColorBrush x:Key="BrandBlue" Color="#3498DB"/>
        <SolidColorBrush x:Key="BrandOrange" Color="#E67E22"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#2ECC71"/>
        <SolidColorBrush x:Key="BrandDark" Color="#34495E"/>

        <!-- Base Card Style -->
        <Style x:Key="LightCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#111111" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.03"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI Card Value Style -->
        <Style x:Key="KPIValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <!-- KPI Card Title Style -->
        <Style x:Key="KPITitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- Styled DataGrid for Light Theme -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFC"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="45"/>
        </Style>

        <Style x:Key="DataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Button Style -->
        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrandBlue}"/>
                                <Setter TargetName="border" Property="Background" Value="#F4F9FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <!-- Title Row -->
            <RowDefinition Height="Auto"/>
            <!-- KPI Cards Row -->
            <RowDefinition Height="Auto"/>
            <!-- Charts and Actions Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Grid.Column="0">
                <TextBlock Text="Dashboard" Foreground="{StaticResource TextPrimary}" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Welcome back! Here's what's happening today." Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Tuesday, December 23, 2025" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Background="{StaticResource BrandBlue}" BorderThickness="0" Padding="15,8" Cursor="Hand" Click="btnRefresh_Click" Foreground="White" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    Refresh Data
                </Button>
            </StackPanel>
        </Grid>

        <!-- KPI CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Students (Blue) -->
            <Border Grid.Column="0" Style="{StaticResource LightCard}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource BrandBlue}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL STUDENTS" Style="{StaticResource KPITitleText}"/>
                        <TextBlock x:Name="txtTotalStudents" Text="0" Style="{StaticResource KPIValueText}"/>
                        <TextBlock x:Name="txtNewStudents" Text="+0% from last month" Foreground="{StaticResource BrandGreen}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EBF5FB" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Top">
                        <Path Data="M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4s-4,1.79-4,4S9.79,12,12,12z M12,14c-2.67,0-8,1.34-8,4v2h16v-2C20,15.34,14.67,14,12,14z" 
                              Fill="{StaticResource BrandBlue}" Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Batches (Orange) -->
            <Border Grid.Column="1" Style="{StaticResource LightCard}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource BrandOrange}" Margin="8,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ACTIVE BATCHES" Style="{StaticResource KPITitleText}"/>
                        <TextBlock x:Name="txtActiveBatches" Text="0" Style="{StaticResource KPIValueText}"/>
                        <TextBlock x:Name="txtWaitingList" Text="-0% from last week" Foreground="{StaticResource BrandOrange}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FDF2E9" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Top">
                        <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" 
                              Fill="{StaticResource BrandOrange}" Width="18" Height="18" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Attendance (Green) -->
            <Border Grid.Column="2" Style="{StaticResource LightCard}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource BrandGreen}" Margin="8,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ATTENDANCE RATE" Style="{StaticResource KPITitleText}"/>
                        <TextBlock x:Name="txtAttendanceRate" Text="0%" Style="{StaticResource KPIValueText}"/>
                        <TextBlock Text="+0% from yesterday" Foreground="{StaticResource BrandGreen}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EAFAF1" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Top">
                        <Path Data="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" 
                              Fill="{StaticResource BrandGreen}" Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Revenue (Dark Slate) -->
            <Border Grid.Column="3" Style="{StaticResource LightCard}" BorderThickness="4,1,1,1" BorderBrush="{StaticResource BrandDark}" Margin="12,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL REVENUE" Style="{StaticResource KPITitleText}"/>
                        <TextBlock x:Name="txtTotalEarnings" Text="$0" Style="{StaticResource KPIValueText}"/>
                        <TextBlock Text="+0% from last week" Foreground="{StaticResource BrandGreen}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EBEDEF" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Top">
                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 9h-2V7h-2v5H6v2h2v5h2v-5h2v-2z" 
                              Fill="{StaticResource BrandDark}" Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- MIDDLE SECTION (3 Columns) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Pass Rates / Enrollment Trend -->
            <Border Grid.Column="0" Style="{StaticResource LightCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Enrollment Trend" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Canvas x:Name="ChartCanvas" Grid.Row="1" Background="Transparent" SizeChanged="ChartCanvas_SizeChanged" ClipToBounds="True"/>
                </Grid>
            </Border>

            <!-- 2. Quick Actions -->
            <Border Grid.Column="1" Style="{StaticResource LightCard}" Margin="8,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Quick Actions" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                        <!-- Take Attendance -->
                        <Button Style="{StaticResource QuickActionButton}" Click="btnAttendance_Click">
                            <StackPanel VerticalAlignment="Center">
                                <Path Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" 
                                      Fill="{StaticResource BrandGreen}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,0,10"/>
                                <TextBlock Text="Take Attendance" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Manage Students -->
                        <Button Style="{StaticResource QuickActionButton}" Click="btnStudents_Click">
                            <StackPanel VerticalAlignment="Center">
                                <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" 
                                      Fill="{StaticResource BrandBlue}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,0,10"/>
                                <TextBlock Text="Manage Students" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Schedule Test -->
                        <Button Style="{StaticResource QuickActionButton}" Click="btnScheduleTest_Click">
                            <StackPanel VerticalAlignment="Center">
                                <Path Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm-5-7h-4v4h4v-4z" 
                                      Fill="{StaticResource BrandOrange}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,0,10"/>
                                <TextBlock Text="Schedule Test" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Courses -->
                        <Button Style="{StaticResource QuickActionButton}" Click="btnCourses_Click">
                            <StackPanel VerticalAlignment="Center">
                                <Path Data="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5.47 18.6L12 22l6.53-3.4V15.6L12 19l-6.53-3.4v3z" 
                                      Fill="{StaticResource BrandDark}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,0,10"/>
                                <TextBlock Text="View Courses" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- 3. Recent Students Table -->
            <Border Grid.Column="2" Style="{StaticResource LightCard}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Recent Enrolled Students" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <DataGrid x:Name="dgvRecentStudents" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student Name" Binding="{Binding FullName}" Width="*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Course" Binding="{Binding ClassName}" Width="1.2*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding EnrollmentDate, StringFormat={}{0:MMM dd, yyyy}}" Width="1*" HeaderStyle="{StaticResource DataGridColumnHeader}"/>
                            
                            <!-- Custom Status Column styled like the 'Pending/Approved' badges in the image -->
                            <DataGridTemplateColumn Header="Status" Width="0.8*" HeaderStyle="{StaticResource DataGridColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Mocking a badge since we don't have a status field in Student Enrollment -->
                                        <Border Background="#EAF2F8" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="Active" Foreground="{StaticResource BrandBlue}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
