<UserControl x:Class="WPFPLDashboards.ucDriveWayDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="#F8F9FA"
             FontFamily="Segoe UI, Inter, Arial">
    
    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MainBackground" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        
        <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
        
        <!-- Brand Colors -->
        <SolidColorBrush x:Key="BrandBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="BrandBlueHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="BrandOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="BrandRed" Color="#EF4444"/>

        <!-- Styles -->
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Item Button -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Active Item Button -->
        <Style x:Key="SidebarActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BrandBlue}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandBlueHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandBlue}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandBlueHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo Area -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                    <Path Data="M18.92 6.01C18.72 5.42 18.16 5 17.5 5H6.5C5.84 5 5.28 5.42 5.08 6.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 6.5h11l1.5 4.5h-14l1.5-4.5zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" 
                          Fill="{StaticResource BrandBlue}" Width="24" Height="24" Stretch="Uniform"/>
                    <TextBlock Text="DriveWay" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1" Margin="0,10">
                    <Button Style="{StaticResource SidebarActiveButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="White" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" x:Name="btnStudentsSidebar">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" 
                                  Fill="{StaticResource TextSecondary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Students"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" 
                                  Fill="{StaticResource TextSecondary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Instructors"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" x:Name="btnFleetSidebar">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M18.92 6.01C18.72 5.42 18.16 5 17.5 5H6.5C5.84 5 5.28 5.42 5.08 6.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 6.5h11l1.5 4.5h-14l1.5-4.5z" 
                                  Fill="{StaticResource TextSecondary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Fleet"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z" 
                                  Fill="{StaticResource TextSecondary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Scheduling"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" 
                                  Fill="{StaticResource TextSecondary}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Payments"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Dashboard" FontWeight="Bold" FontSize="24" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>

                    <!-- Search Bar -->
                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Center" Width="300" Height="40" Margin="0,0,24,0">
                        <Grid>
                            <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                                  Fill="{StaticResource TextSecondary}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0"/>
                            <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="36,0,10,0" FontSize="14" Foreground="{StaticResource TextPrimary}"
                                     Text="Search Students..."/>
                        </Grid>
                    </Border>

                    <!-- Right Icons & Profile -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Background="Transparent" BorderThickness="0" Margin="0,0,16,0" Cursor="Hand">
                            <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z" Fill="{StaticResource TextSecondary}" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" Margin="0,0,24,0" Cursor="Hand">
                            <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12zM7 9h10v2H7z" Fill="{StaticResource TextSecondary}" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource BrandBlue}" Margin="0,0,12,0">
                            <TextBlock Text="AR" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Cursor="Hand">
                            <TextBlock Text="Alex R." FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" FontSize="14"/>
                            <TextBlock Text="Admin" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scrollable Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- KPI Cards Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Total Students -->
                        <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="12" Padding="24" Background="{StaticResource BrandBlue}">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource BrandBlue}" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Students" Foreground="#E0E7FF" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="txtTotalStudents" Text="1,284" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="+12% ↑" Foreground="#A5B4FC" FontSize="14" FontWeight="SemiBold"/>

                                <Path Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                                      Fill="#60A5FA" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Top"/>

                                <Button Grid.Row="2" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" FontWeight="Bold" Cursor="Hand" x:Name="btnStudentsViewDetails" VerticalAlignment="Bottom">
                                    <TextBlock Text="VIEW DETAILS"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 2: Active Vehicles -->
                        <Border Grid.Column="1" Margin="12,0" CornerRadius="12" Padding="24" Background="{StaticResource BrandGreen}">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource BrandGreen}" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Active Vehicles" Foreground="#D1FAE5" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="txtActiveVehicles" Text="22 / 25" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="txtAvailability" Text="88% availability" Foreground="#A7F3D0" FontSize="14" FontWeight="SemiBold"/>

                                <Path Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Data="M18.92 6.01C18.72 5.42 18.16 5 17.5 5H6.5C5.84 5 5.28 5.42 5.08 6.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 6.5h11l1.5 4.5h-14l1.5-4.5z" 
                                      Fill="#34D399" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Top"/>

                                <Button Grid.Row="2" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" FontWeight="Bold" Cursor="Hand" x:Name="btnFleetStatus" VerticalAlignment="Bottom">
                                    <TextBlock Text="FLEET STATUS"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 3: Today's Lessons -->
                        <Border Grid.Column="2" Margin="12,0,0,0" CornerRadius="12" Padding="24" Background="{StaticResource BrandOrange}">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource BrandOrange}" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Today's Lessons" Foreground="#FEF3C7" FontSize="14" FontWeight="Medium"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="txtTodayLessons" Text="39" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="15 completed" Foreground="#FDE68A" FontSize="14" FontWeight="SemiBold"/>

                                <Path Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" 
                                      Fill="#FBBF24" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Top"/>

                                <Button Grid.Row="2" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Bottom">
                                    <TextBlock Text="SCHEDULE"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Middle Section: Schedule & Stats -->
                    <Grid Grid.Row="1" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Weekly Lesson Schedule -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Weekly Lesson Schedule" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Background="Transparent" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="8,4" CornerRadius="4,0,0,4">
                                            <Path Data="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z" Fill="{StaticResource TextSecondary}" Width="16" Height="16" Stretch="Uniform"/>
                                        </Button>
                                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1" Padding="16,4" Background="White">
                                            <TextBlock Text="Oct 23 - Oct 27" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Background="Transparent" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="8,4" CornerRadius="0,4,4,0" Margin="0,0,16,0">
                                            <Path Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z" Fill="{StaticResource TextSecondary}" Width="16" Height="16" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Schedule Grid Placeholder (Populated via code-behind) -->
                                <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Grid x:Name="gridSchedule" Background="White">
                                        <!-- Columns/Rows and Mock Data injected in cs -->
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right Stats Panel -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,24" x:Name="btnNewLesson">
                                <TextBlock Text="New Lesson +" FontSize="15"/>
                            </Button>

                            <TextBlock Text="Upcoming Lessons" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15" Margin="0,0,0,8"/>
                            <TextBlock Text="39 scheduled" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,24"/>

                            <TextBlock Text="Instructor Availability" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="15 vehicles" Foreground="{StaticResource BrandGreen}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <TextBlock Text="22" Foreground="{StaticResource BrandGreen}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,24">
                                <TextBlock Text="20 completed" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <TextBlock Text="15%" Foreground="{StaticResource BrandGreen}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="Today's Stats" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="15" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="39 scheduled" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <TextBlock Text="39" Foreground="{StaticResource BrandOrange}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,24">
                                <TextBlock Text="15 completed" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <TextBlock Text="88%" Foreground="{StaticResource BrandGreen}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Section: Recent Enrollments -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="Recent Student Enrollments" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                            
                            <DataGrid x:Name="dgvRecentStudents" Grid.Row="1" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Student Name" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="#E2E8F0" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="Enrollment Date" Binding="{Binding EnrollmentDate, StringFormat={}{0:MMM dd, yyyy}}" Width="*" />
                                    <DataGridTextColumn Header="Course Type" Binding="{Binding CourseName}" Width="*" />
                                    
                                    <DataGridTemplateColumn Header="Status" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBgColor}" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusTextColor}" FontSize="12" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTemplateColumn Header="Actions" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="View/Edit" Foreground="{StaticResource BrandBlue}" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
